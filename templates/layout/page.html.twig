{#
/**
 * @file
 * Theme override to display a single page.
 *
 * Header bar (branding and menus), a gilt divider, <main> with an optional
 * sidebar, and a footer with a brand column, up to three link columns and
 * a legal row. An optional search dialog follows the footer.
 *
 * `.pico` scopes Pico CSS's conditional build to the page, so the admin
 * toolbar and dialogs keep their core styling. The header and footer follow
 * the page's color scheme (see knowles_preprocess_html()).
 *
 * Extra variables (knowles_preprocess_page()):
 * - site_name: The site name.
 * - content_font: 'sans' or 'serif', the main content font.
 * - footer_copyright: The copyright line, or NULL to hide it.
 * - theme_credit: Whether to print the theme credit.
 * - theme_label, theme_version: The theme's name and version.
 * - search_button: Whether to print the header search button.
 * - search_label: The search button label.
 * - search_url: The search page URL (the button's no-JS fallback).
 * - search_modal: Whether the button opens the search_modal region in a
 *   dialog.
 * - search_title: The search dialog heading.
 */
#}
{% set has_sidebar = page.sidebar|render|striptags|trim is not empty %}
{%
  set main_classes = [
    'container',
    'site-main',
    'site-main--font-' ~ content_font,
    has_sidebar ? 'site-main--with-sidebar',
  ]
%}
<div class="page pico">

  <header class="site-header" role="banner">
    <div class="site-header-bar container">
      {{ page.header }}
      {% if page.primary_menu %}
        <div class="site-header-nav">
          {{ page.primary_menu }}
        </div>
      {% endif %}
      {% if search_button %}
        <a href="{{ search_url ?: '#site-search' }}" class="site-search-button{{ search_modal ? ' js-search-modal-trigger' }}"{% if search_modal %} aria-haspopup="dialog" aria-controls="site-search"{% endif %}>
          <span class="site-search-button__label">{{ search_label }}</span>
        </a>
      {% endif %}
    </div>
  </header>

  <div class="site-main-bar" aria-hidden="true"></div>

  {% if page.breadcrumb or page.highlighted %}
    <div class="container site-pre-content">
      {{ page.breadcrumb }}
      {{ page.highlighted }}
    </div>
  {% endif %}

  <main id="main-content" tabindex="-1" class="{{ main_classes|join(' ')|trim }}">
    <div class="site-main__content">
      {{ page.help }}
      {{ page.content_top }}
      {{ page.content }}
    </div>
    {% if has_sidebar %}
      <aside class="site-main__sidebar" role="complementary">
        {{ page.sidebar }}
      </aside>
    {% endif %}
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="site-footer__inner container">

      <div class="site-footer__brand">
        {{ page.footer_brand }}
        {% if theme_credit %}
          <p class="site-footer__powered">
            <img src="{{ base_path }}core/misc/druplicon.png" alt="Drupal" class="site-footer__druplicon" width="18" height="20" loading="lazy">
            {{ 'Theme:'|t }} <span class="site-footer__theme-name">{{ theme_label }} {{ theme_version }}</span>
            {{ 'based on'|t }} <a href="https://picocss.com/" target="_blank" rel="noopener noreferrer">Pico</a>
          </p>
        {% endif %}
      </div>

      <div class="site-footer__right">
        {% if page.footer_first or page.footer_second or page.footer_third %}
          <div class="site-footer__links">
            {% for column in [page.footer_first, page.footer_second, page.footer_third] %}
              {% if column %}
                <div class="site-footer__link-col">{{ column }}</div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if footer_copyright or page.footer_legal %}
          <div class="site-footer__legal">
            {% if footer_copyright %}
              <span class="site-footer__copyright">{{ footer_copyright }}</span>
            {% endif %}
            {{ page.footer_legal }}
          </div>
        {% endif %}
      </div>

    </div>
  </footer>

  {#
    Search dialog (Pico's <dialog><article> pattern), opened by the header
    search button or any `.js-search-modal-trigger` link (js/search-modal.js).
    `ui-front` makes jQuery UI append autocomplete lists inside the dialog:
    a dialog opened with showModal() sits in the top layer, so a list
    appended to <body> would render underneath it.
  #}
  {% if search_modal %}
    {{ attach_library('knowles/search-modal') }}
    <dialog id="site-search" class="search-modal ui-front" aria-labelledby="site-search-title">
      <article class="search-modal__panel">
        <header class="search-modal__header">
          <button type="button" class="search-modal__close" aria-label="{{ 'Close'|t }}" data-search-modal-close></button>
          <p class="search-modal__eyebrow">{{ site_name }}</p>
          <h2 id="site-search-title" class="search-modal__title">{{ search_title }}</h2>
        </header>
        {{ page.search_modal }}
        <p class="search-modal__hint">{{ 'Press <kbd>Esc</kbd> to close.'|t }}</p>
      </article>
    </dialog>
  {% endif %}

</div>
