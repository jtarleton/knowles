{#
/**
 * @file
 * Theme override for the basic structure of a single Drupal page.
 *
 * Adds data-theme to <html> so Pico and the theme pick the color scheme:
 * "auto" (follow the device), "dark" or "light". See
 * knowles_preprocess_html().
 *
 * @see template_preprocess_html()
 */
#}
<!DOCTYPE html>
<html{{ html_attributes.setAttribute('data-theme', color_scheme|default('auto')) }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
  </head>
  <body{{ attributes }}>
    <a href="#main-content" class="skip-link visually-hidden focusable">
      {{ 'Skip to main content'|t }}
    </a>
    {{ page_top }}
    {{ page }}
    {{ page_bottom }}
    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>
