{#
/**
 * @file
 * Local task tabs (View / Edit / Delete...).
 *
 * stable9 prints bare <ul>s; the classes here are what the tab rail in
 * css/components/drupal.css styles.
 */
#}
{% if primary %}
  <h2 class="visually-hidden">{{ 'Primary tabs'|t }}</h2>
  <ul class="tabs primary">{{ primary }}</ul>
{% endif %}
{% if secondary %}
  <h2 class="visually-hidden">{{ 'Secondary tabs'|t }}</h2>
  <ul class="tabs secondary">{{ secondary }}</ul>
{% endif %}
